# =====================================================================
# AI-Powered Personal Diet Planner with Cloud Storage
# CLOUD MODE configuration — used when deploying to Render/Vercel/Supabase.
# See docs/cloud-deployment.md for the full walkthrough.
# =====================================================================

# ----- Application -----
APP_NAME="AI-Powered Personal Diet Planner"
ENVIRONMENT=cloud
API_HOST=0.0.0.0
API_PORT=8000

# ----- Security secrets (set via hosting dashboard, never in git) -----
SECRET_KEY=<generate-with-python-secrets-token-urlsafe>
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ----- Managed database: Supabase Postgres (free tier) -----
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ----- Object storage: Supabase private bucket (free tier) -----
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key-keep-secret>
SUPABASE_STORAGE_BUCKET=diet-planner-files
MAX_FILE_SIZE_MB=5

# ----- Auth provider -----
AUTH_PROVIDER=local

# ----- CORS: production frontend origin(s) -----
CORS_ORIGINS=https://<your-app>.vercel.app,http://localhost:5173

# ----- Rate limiting -----
RATE_LIMIT_DEFAULT=100/minute

# ----- AI engine (OPTIONAL — rule-based fallback always available) -----
AI_PROVIDER=auto
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=<set-in-hosting-secrets-never-in-git>
AI_API_MODEL=gpt-4o-mini

# =====================================================================
# AI-Powered Personal Diet Planner with Cloud Storage
# LOCAL MODE configuration — copy this file to `.env` and edit.
# In local mode, EVERYTHING runs on your machine. No internet, no
# credit card, no cloud account needed.
# =====================================================================

# ----- Application -----
APP_NAME="AI-Powered Personal Diet Planner"
ENVIRONMENT=local
API_HOST=0.0.0.0
API_PORT=8000

# ----- Security secrets (GENERATE YOUR OWN — never commit .env) -----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ----- Database (CLOUD ABSTRACTION LAYER) -----
# local mode  -> SQLite file on disk
# cloud mode  -> Supabase Postgres connection string
DATABASE_URL=sqlite:///./diet_planner.db

# ----- Storage (CLOUD ABSTRACTION LAYER) -----
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# ----- Auth provider (LOCAL MODE issues its own JWT) -----
AUTH_PROVIDER=local

# ----- CORS: allowed frontend origins (comma separated) -----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Rate limiting -----
RATE_LIMIT_DEFAULT=100/minute

# ----- AI engine (OPTIONAL) -----
# Leave AI_API_KEY empty to always use the local rule-based engine.
# Any AI API failure automatically falls back to the rule-based engine.
AI_PROVIDER=rule_based
AI_API_URL=
AI_API_KEY=
AI_API_MODEL=gpt-4o-mini

# =====================================================================
# CLOUD MODE (Supabase free tier) — fill ONLY when deploying.
# See docs/cloud-deployment.md for a step-by-step guide.
# =====================================================================
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service-role-key-keep-secret>
# SUPABASE_STORAGE_BUCKET=diet-planner-files
# AUTH_PROVIDER=supabase
# SUPABASE_ANON_KEY=<anon-public-key>
